# Copia este archivo como .env y cambia los valores.
# Genera una clave con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Por defecto usa SQLite en instance/ciberguard.db. Para MySQL en PythonAnywhere:
# DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@USUARIO.mysql.pythonanywhere-services.com/USUARIO$ciberguard
# En producción (HTTPS) déjalo en 1 para que la cookie de sesión solo viaje cifrada.
SESSION_COOKIE_SECURE=1
